#!/usr/bin/env bash
# Robust LMB VPS Docker deployment. Run from the repository root.
set -Eeuo pipefail
IFS=$'\n\t'

APP_NAME="LMB"
GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; NC='\033[0m'
info(){ printf "${GREEN}[%s]${NC} %s\n" "$APP_NAME" "$*"; }
warn(){ printf "${YELLOW}[WARN]${NC} %s\n" "$*"; }
die(){ printf "${RED}[ERROR]${NC} %s\n" "$*" >&2; exit 1; }
run_root(){ if [ "$(id -u)" -eq 0 ]; then "$@"; elif command -v sudo >/dev/null 2>&1; then sudo "$@"; else die "Root privileges are required. Run as root or install sudo."; fi; }

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"
[[ -f docker-compose.yml && -f Dockerfile && -f requirements.txt ]] || die "Run from the LMB project root; docker-compose.yml, Dockerfile, and requirements.txt must exist."
command -v python3 >/dev/null 2>&1 || die "Python 3 is required to validate and write the environment file."

sed -i 's/\r$//' start.sh deploy.vps deploy.sh deploy-user.vps one-click-deploy.sh setpkgs.sh 2>/dev/null || true
chmod +x start.sh deploy.vps deploy.sh deploy-user.vps one-click-deploy.sh setpkgs.sh 2>/dev/null || true

PROJECT_SLUG="$(basename "$SCRIPT_DIR" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9_-]+/-/g; s/^-+|-+$//g')"
PROJECT_SLUG="${PROJECT_SLUG:-lmb}"
export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-$PROJECT_SLUG}"

# Stop legacy bare-metal systemd bot services if present to avoid Telegram session conflicts.
for legacy_svc in lmb_bot cantarellabots_bot; do
  if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet "$legacy_svc" 2>/dev/null; then
    warn "Stopping legacy systemd service $legacy_svc before starting Docker container..."
    run_root systemctl disable --now "$legacy_svc" >/dev/null 2>&1 || true
  fi
done

# Host prerequisites.
if ! command -v curl >/dev/null 2>&1; then
  if command -v apt-get >/dev/null 2>&1; then
    run_root apt-get update -qq
    run_root apt-get install -y -qq curl ca-certificates
  elif command -v dnf >/dev/null 2>&1; then
    run_root dnf install -y curl ca-certificates
  else
    die "curl is missing. Install curl and ca-certificates, then rerun."
  fi
fi

if ! command -v docker >/dev/null 2>&1; then
  info "Installing Docker Engine and Compose plugin..."
  curl -fsSL https://get.docker.com -o "/tmp/${PROJECT_SLUG}-get-docker.sh" || die "Could not download Docker installer. Check VPS DNS/network access."
  run_root sh "/tmp/${PROJECT_SLUG}-get-docker.sh"
  rm -f "/tmp/${PROJECT_SLUG}-get-docker.sh"
fi
run_root systemctl enable --now docker || die "Docker service could not be started. Check: sudo systemctl status docker --no-pager"

DOCKER=(docker)
if ! docker info >/dev/null 2>&1; then
  if command -v sudo >/dev/null 2>&1 && sudo docker info >/dev/null 2>&1; then
    DOCKER=(sudo docker)
    warn "Using sudo for Docker because this login session lacks Docker socket permission."
  else
    die "Docker daemon is not accessible. Check 'sudo systemctl status docker' and 'sudo docker info'."
  fi
fi

if "${DOCKER[@]}" compose version >/dev/null 2>&1; then
  COMPOSE=("${DOCKER[@]}" compose)
elif command -v docker-compose >/dev/null 2>&1; then
  if [[ "${DOCKER[0]}" == sudo ]]; then COMPOSE=(sudo docker-compose); else COMPOSE=(docker-compose); fi
else
  warn "Docker Compose plugin missing; attempting package installation..."
  if command -v apt-get >/dev/null 2>&1; then
    run_root apt-get update -qq
    run_root apt-get install -y docker-compose-plugin
  elif command -v dnf >/dev/null 2>&1; then
    run_root dnf install -y docker-compose-plugin
  fi
  if "${DOCKER[@]}" compose version >/dev/null 2>&1; then COMPOSE=("${DOCKER[@]}" compose); else die "Docker Compose is unavailable. Install the Docker Compose plugin and rerun."; fi
fi

# Persistent host directories mounted into the container.
mkdir -p .sessions downloads thumbnails tokens rclone cookies Images configs/sabnzbd logs
chmod 700 .sessions 2>/dev/null || true
[[ -f config.py ]] || printf '# LMB config (environment variables in .env take precedence)\n' > config.py

# Detect current project's own running web port (if any) so re-deploys keep their port,
# while a second deployment on the same VPS automatically picks a free port if 8080 is taken.
OWN_WEB_PORT="$("${DOCKER[@]}" ps --filter "label=com.docker.compose.project=${COMPOSE_PROJECT_NAME}" --filter "label=com.docker.compose.service=lmb" --format '{{.Ports}}' 2>/dev/null | sed -nE 's/.*:([0-9]+)->.*/\1/p' | head -n 1 || true)"
EXPLICIT_PORT_SET="0"
if [[ -n "${BASE_URL_PORT:-}" || -n "${PORT:-}" ]]; then EXPLICIT_PORT_SET="1"; fi

# Normalize lowercase cmd_suffix if exported.
if [[ -z "${CMD_SUFFIX:-}" && -n "${cmd_suffix:-}" ]]; then
  export CMD_SUFFIX="$cmd_suffix"
fi

OWN_WEB_PORT="$OWN_WEB_PORT" EXPLICIT_PORT_SET="$EXPLICIT_PORT_SET" python3 - <<'PY'
import json, os, pathlib, re, runpy, socket

p = pathlib.Path('.env')

def read_env(path):
    if not path.exists():
        return {}
    result = {}
    for raw in path.read_text(encoding='utf-8', errors='ignore').splitlines():
        line = raw.strip()
        if not line or line.startswith('#'):
            continue
        if line.startswith('export '):
            line = line[7:].lstrip()
        if '=' not in line:
            continue
        key, value = line.split('=', 1)
        key, value = key.strip(), value.strip()
        if not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', key):
            continue
        if len(value) >= 2 and value[0] == value[-1] and value[0] in ('"', "'"):
            if value[0] == '"':
                try:
                    value = json.loads(value)
                except Exception:
                    value = value[1:-1]
            else:
                value = value[1:-1]
        result[key] = value
    return result

def port_in_use(port_num):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        try:
            s.bind(('0.0.0.0', port_num))
            return False
        except OSError:
            return True

values = {}
cfg_keys = set()
cfg_path = pathlib.Path('config.py')
if cfg_path.exists():
    ns = runpy.run_path(str(cfg_path))
    for k, v in ns.items():
        if k.isupper() and not k.startswith('__'):
            cfg_keys.add(k)
            if isinstance(v, (dict, list, tuple)):
                values[k] = repr(v)
            elif isinstance(v, bool):
                values[k] = 'True' if v else 'False'
            elif v is not None:
                values[k] = str(v)

# Merge existing .env (non-empty values override config.py defaults)
for k, v in read_env(p).items():
    if str(v).strip() != '':
        values[k] = v

aliases = {
    'API_ID': 'TELEGRAM_API',
    'APP_ID': 'TELEGRAM_API',
    'API_HASH': 'TELEGRAM_HASH',
    'MONGODB_URI': 'DATABASE_URL',
    'DATABASE_URI': 'DATABASE_URL',
    'PORT': 'BASE_URL_PORT',
    'cmd_suffix': 'CMD_SUFFIX',
}
for alias, canonical in aliases.items():
    if os.environ.get(alias) and not os.environ.get(canonical):
        os.environ[canonical] = os.environ[alias]

extra_keys = {
    'BOT_TOKEN', 'OWNER_ID', 'TELEGRAM_API', 'TELEGRAM_HASH', 'DATABASE_URL',
    'USER_SESSION_STRING', 'AUTHORIZED_CHATS', 'SUDO_USERS', 'LEECH_LOG_CHAT',
    'LEECH_DUMP_CHAT', 'BASE_URL', 'BASE_URL_PORT', 'CMD_SUFFIX',
    'START_REPO_URL', 'START_REPO_BUTTON',
    'START_UPDATE_URL', 'START_UPDATE_BUTTON',
    'START_DEV_URL', 'START_DEV_BUTTON',
    'CBGRAM_RUST_CORE', 'CBGRAM_UVLOOP', 'CBGRAM_MAX_CONCURRENT', 'CBGRAM_WORKERS', 'CBGRAM_SESSION_DIR',
    'BOT_THREAD_POOL_SIZE', 'BOT_HARD_TASK_LIMIT',
}
# Shell-exported credentials ALWAYS win over config.py and previous .env
for key in sorted(cfg_keys | extra_keys):
    if key in os.environ:
        env_val = os.environ.get(key)
        if env_val is not None and (str(env_val).strip() != '' or key == 'CMD_SUFFIX'):
            values[key] = env_val

values.setdefault('CBGRAM_RUST_CORE', '1')
values.setdefault('CBGRAM_UVLOOP', '1')
values.setdefault('CBGRAM_MAX_CONCURRENT', '256')
values.setdefault('CBGRAM_WORKERS', '128')
values['CBGRAM_SESSION_DIR'] = '/usr/src/app/.sessions'

own_port = os.environ.get('OWN_WEB_PORT', '').strip()
explicit_port = os.environ.get('EXPLICIT_PORT_SET', '0') == '1'
try:
    desired_port = int(str(values.get('BASE_URL_PORT') or '8080').strip())
except ValueError:
    desired_port = 8080

if not explicit_port and str(desired_port) != own_port and port_in_use(desired_port):
    candidate = desired_port + 1
    while candidate < 8200 and port_in_use(candidate) and str(candidate) != own_port:
        candidate += 1
    print(f"[INFO] Port {desired_port} is already in use by another service; assigning BASE_URL_PORT={candidate} for this deployment.")
    desired_port = candidate
values['BASE_URL_PORT'] = str(desired_port)

lines = ['# Generated by deploy.vps (LMB); contains secrets. Do not commit or share.']
for key in sorted(values):
    val = str(values[key])
    if val == '' and key != 'CMD_SUFFIX':
        continue
    lines.append(f'{key}={json.dumps(val)}')
p.write_text('\n'.join(lines) + '\n', encoding='utf-8')
os.chmod(p, 0o600)
PY

# Strict preflight validation
python3 - <<'PY'
import json, pathlib, re, sys
v = {}
for line in pathlib.Path('.env').read_text(encoding='utf-8').splitlines():
    if not line or line.lstrip().startswith('#') or '=' not in line:
        continue
    k, raw = line.split('=', 1); raw = raw.strip()
    try:
        value = json.loads(raw) if raw.startswith('"') else raw
    except Exception:
        value = raw.strip('"')
    v[k.strip()] = str(value)

for k in ('BOT_TOKEN', 'TELEGRAM_API', 'TELEGRAM_HASH', 'OWNER_ID'):
    val = v.get(k, '').strip()
    if not val or val.lower().startswith(('your_', 'change_me', 'replace_')):
        sys.exit(f'[ERROR] {k} is missing or still a placeholder. Export it before deployment or edit config.py.')

for k in ('TELEGRAM_API', 'OWNER_ID'):
    if not re.fullmatch(r'-?\d+', v[k].strip()):
        sys.exit(f'[ERROR] {k} must be numeric.')
PY

info "Validating Docker Compose configuration (project=${COMPOSE_PROJECT_NAME})..."
"${COMPOSE[@]}" config --quiet || die "Compose configuration is invalid. Check .env and docker-compose.yml."
info "Building and starting LMB container..."
"${COMPOSE[@]}" up -d --build --remove-orphans

PORT_VALUE="$(python3 - <<'PY'
import json, pathlib
for line in pathlib.Path('.env').read_text(encoding='utf-8').splitlines():
    if line.startswith('BASE_URL_PORT='):
        raw = line.split('=', 1)[1].strip()
        try:
            print(json.loads(raw))
        except Exception:
            print(raw.strip('"'))
        break
PY
)"
PORT_VALUE="${PORT_VALUE:-8080}"

if command -v ufw >/dev/null 2>&1 && run_root ufw status 2>/dev/null | grep -qi "Status: active"; then
  run_root ufw allow "${PORT_VALUE}/tcp" >/dev/null 2>&1 || true
fi
if command -v firewall-cmd >/dev/null 2>&1 && run_root firewall-cmd --state >/dev/null 2>&1; then
  run_root firewall-cmd --permanent --add-port="${PORT_VALUE}/tcp" >/dev/null 2>&1 || true
  run_root firewall-cmd --reload >/dev/null 2>&1 || true
fi

LOG_CMD="docker compose -p ${COMPOSE_PROJECT_NAME} logs -f lmb"
if [[ "${DOCKER[0]}" == sudo ]]; then
  LOG_CMD="sudo docker compose -p ${COMPOSE_PROJECT_NAME} logs -f lmb"
fi

info "Waiting up to 90s for LMB bot inside container (${COMPOSE_PROJECT_NAME}) to finish startup..."
sleep 4
for _ in $(seq 1 43); do
  if ! "${COMPOSE[@]}" ps --status running 2>/dev/null | grep -q "lmb" || \
     ! "${COMPOSE[@]}" exec -T lmb pgrep -f 'python.*-m bot' >/dev/null 2>&1; then
    break
  fi
  if "${COMPOSE[@]}" logs --tail=150 lmb 2>/dev/null | grep -qE "WZ Client\(s\) & Services Started|Bot Started"; then
    info "LMB container and bot are online (project=${COMPOSE_PROJECT_NAME}, port=${PORT_VALUE})."
    "${COMPOSE[@]}" ps
    info "Recent bot logs:"
    "${COMPOSE[@]}" logs --tail=20 lmb || true
    info "Follow live logs with: ${LOG_CMD}"
    exit 0
  fi
  sleep 2
done

if "${COMPOSE[@]}" ps --status running 2>/dev/null | grep -q "lmb" && \
   "${COMPOSE[@]}" exec -T lmb pgrep -f 'python.*-m bot' >/dev/null 2>&1; then
  warn "LMB container is running, but startup banner not seen yet. Recent logs:"
  "${COMPOSE[@]}" logs --tail=40 lmb || true
  info "Follow live logs with: ${LOG_CMD}"
  exit 0
fi

warn "Bot process inside container did not stay running. Showing status and recent logs:"
"${COMPOSE[@]}" ps || true
"${COMPOSE[@]}" logs --tail=120 lmb || true
die "LMB bot failed to start inside container. Check credentials (BOT_TOKEN/TELEGRAM_API/TELEGRAM_HASH/OWNER_ID) and logs above."
